#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
# nucleon-sync-omarchy — adds Nucleon Sync to the Omarchy 4 desktop, idempotently, and removes it again.
#
#   nucleon-sync-omarchy install   [--dry-run] [--no-bar] [--no-menu] [--waybar]
#   nucleon-sync-omarchy uninstall [--dry-run]
#   nucleon-sync-omarchy status
#
# What it touches (nothing else; every change is validated and backed up as <file>.nucleon-sync.bak first):
#   ~/.config/omarchy/shell.json                     bar entry {"id":"nucleon-sync","type":"command",...} in the
#                                                    right section before the tray (Omarchy 4 shell, no Waybar)
#   ~/.config/omarchy/extensions/omarchy-menu.jsonc  menu block between "// >>> nucleon-sync" and "// <<< nucleon-sync"
#   --waybar (Omarchy 3 / plain Hyprland): copies waybar-module.jsonc + waybar.css to ~/.config/waybar/ and prints
#                                          the two lines to add (the Waybar config itself is not edited)
# Theme colours need nothing here: the dashboard reads ~/.local/state/omarchy/current/theme/colors.toml itself and
# follows theme switches. Both config files are watched by the Omarchy shell, so changes apply at once.
set -euo pipefail

ID=nucleon-sync
CFG="${XDG_CONFIG_HOME:-$HOME/.config}"
SHELL_JSON="$CFG/omarchy/shell.json"
MENU="$CFG/omarchy/extensions/omarchy-menu.jsonc"
BEGIN="// >>> $ID (managed by nucleon-sync-omarchy – edits inside this block are overwritten)"
END="// <<< $ID"
HERE="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
# Waybar snippets: next to the script (repository) or in the package's share dir
SNIPPETS="$HERE"
[ -f "$SNIPPETS/waybar-module.jsonc" ] || SNIPPETS=/usr/share/nucleon-sync/omarchy
DRY=0
BAR=1
MENU_ON=1
WAYBAR=0

cmd="${1:-}"
shift || true
for a in "$@"; do
  case "$a" in
    --dry-run) DRY=1 ;;
    --no-bar) BAR=0 ;;
    --no-menu) MENU_ON=0 ;;
    --waybar) WAYBAR=1 ;;
    *) echo "unknown option $a" >&2; exit 2 ;;
  esac
done

say() { printf '%s\n' "$*"; }
need() { command -v "$1" >/dev/null 2>&1 || { say "missing: $1 ($2)" >&2; exit 1; }; }

# commands the bar and the menu run
bar_cmd() {
  if command -v nucleon-sync-bar >/dev/null 2>&1; then echo "nucleon-sync-bar omarchy"; else echo "$HERE/nucleon-sync-bar omarchy"; fi
}
bar_helper() {
  if command -v nucleon-sync-bar >/dev/null 2>&1; then echo "nucleon-sync-bar"; else echo "$HERE/nucleon-sync-bar"; fi
}
open_cmd() {
  if command -v uwsm-app >/dev/null 2>&1; then echo "uwsm-app -- nucleon-sync-gui --open"; else echo "nucleon-sync-gui --open"; fi
}

# whole-line // comments and trailing commas are what the Omarchy menu parser strips (MenuModel.stripJsonc)
jsonc_ok() { sed -E '/^[[:space:]]*\/\//d' "$1" | sed -E -z 's/,([[:space:]]*[]}])/\1/g' | jq -e 'type == "object"' >/dev/null; }

write() { # write <file> <content-file>
  if [ "$DRY" = 1 ]; then
    say "--- would write $1:"
    cat "$2"
    return
  fi
  mkdir -p "$(dirname "$1")"
  [ -f "$1" ] && [ ! -f "$1.nucleon-sync.bak" ] && cp -p "$1" "$1.nucleon-sync.bak"
  cat "$2" >"$1.tmp.$$" && mv "$1.tmp.$$" "$1"
}

reload_shell() {
  [ "$DRY" = 1 ] && return
  command -v omarchy-shell >/dev/null 2>&1 && omarchy-shell shell reloadConfig >/dev/null 2>&1 || true
}

labels() {
  case "${LC_ALL:-${LC_MESSAGES:-${LANG:-}}}" in
    de*) L_APP="Nucleon Sync"; L_DESC="Proton Drive synchronisieren"; L_OPEN="Dashboard öffnen"; L_SYNC="Jetzt synchronisieren"; L_PAUSE="Pausieren"; L_RESUME="Fortsetzen"; L_STATUS="Status anzeigen" ;;
    *) L_APP="Nucleon Sync"; L_DESC="Proton Drive sync"; L_OPEN="Open dashboard"; L_SYNC="Sync now"; L_PAUSE="Pause"; L_RESUME="Resume"; L_STATUS="Show status" ;;
  esac
}

bar_entry() {
  jq -n --arg id "$ID" --arg exec "$(bar_cmd)" --arg open "$(open_cmd)" '{
    id: $id, type: "command", exec: $exec, interval: 5, tooltip: "Nucleon Sync",
    onClick: $open, onRightClick: "nucleon-sync pause --toggle", onMiddleClick: "nucleon-sync sync"
  }'
}

install_bar() {
  need jq "pacman -S jq"
  local tmp entry
  tmp="$(mktemp)"
  entry="$(bar_entry)"
  if [ -f "$SHELL_JSON" ]; then
    jq --argjson e "$entry" '
      def has_entry: [.. | objects | select(.id? == $e.id)] | length > 0;
      if has_entry then
        walk(if type == "array" then map(if type == "object" and .id? == $e.id then $e else . end) else . end)
      else
        (.bar.layout.right // []) as $r
        | ($r | map(.id?) | index("omarchy.tray")) as $i
        | .bar.layout.right = (if $i == null then $r + [$e] else $r[:$i] + [$e] + $r[$i:] end)
      end' "$SHELL_JSON" >"$tmp"
  else
    jq -n --argjson e "$entry" '{version: 1, bar: {layout: {right: [$e]}}}' >"$tmp"
  fi
  jq -e '.version == 1' "$tmp" >/dev/null || { say "refusing: result is not a shell.json (version 1)" >&2; rm -f "$tmp"; exit 1; }
  write "$SHELL_JSON" "$tmp"
  rm -f "$tmp"
  say "bar: $ID in $SHELL_JSON"
}

uninstall_bar() {
  [ -f "$SHELL_JSON" ] || return 0
  need jq "pacman -S jq"
  local tmp
  tmp="$(mktemp)"
  jq --arg id "$ID" 'walk(if type == "array" then map(select((type == "object" and .id? == $id) | not)) else . end)' \
    "$SHELL_JSON" >"$tmp"
  write "$SHELL_JSON" "$tmp"
  rm -f "$tmp"
  say "bar: removed $ID from $SHELL_JSON"
}

menu_block() {
  labels
  local h; h="$(bar_helper)"
  local o; o="$(open_cmd)"
  cat <<EOF
$BEGIN
"$ID": {"icon":"󰅟","label":"$L_APP","description":"$L_DESC"},
"$ID.open": {"icon":"󰍹","label":"$L_OPEN","action":"$o"},
"$ID.sync": {"icon":"󰓦","label":"$L_SYNC","action":"nucleon-sync sync >/dev/null"},
"$ID.pause": {"icon":"󰏤","label":"$L_PAUSE","when":"! $h --is-paused","action":"nucleon-sync pause >/dev/null"},
"$ID.resume": {"icon":"󰐊","label":"$L_RESUME","when":"$h --is-paused","action":"nucleon-sync resume >/dev/null"},
"$ID.status": {"icon":"󰋽","label":"$L_STATUS","action":"$h --notify"},
$END
EOF
}

install_menu() {
  need jq "pacman -S jq"
  local tmp base block
  tmp="$(mktemp)"
  base="$(mktemp)"
  block="$(mktemp)"
  menu_block >"$block"
  if [ -f "$MENU" ]; then
    awk -v id="$ID" '
      $0 ~ "^[[:space:]]*// >>> " id { skip = 1 }
      !skip { print }
      skip && $0 ~ "^[[:space:]]*// <<< " id { skip = 0 }
    ' "$MENU" >"$base"
  else
    printf '{\n}\n' >"$base"
  fi
  # insert right after the opening brace: every entry of ours ends with a comma, the parser drops trailing commas
  awk -v blockfile="$block" '
    !done && /^[[:space:]]*\{/ { print; while ((getline l < blockfile) > 0) print l; done = 1; next }
    { print }
    END { if (!done) exit 3 }
  ' "$base" >"$tmp" || { say "refusing: no opening { in $MENU" >&2; rm -f "$tmp" "$base" "$block"; exit 1; }
  jsonc_ok "$tmp" || { say "refusing: the menu file would not parse (left unchanged)" >&2; rm -f "$tmp" "$base" "$block"; exit 1; }
  write "$MENU" "$tmp"
  rm -f "$tmp" "$base" "$block"
  say "menu: $ID entries in $MENU"
}

uninstall_menu() {
  [ -f "$MENU" ] || return 0
  local tmp
  tmp="$(mktemp)"
  awk -v id="$ID" '
    $0 ~ "^[[:space:]]*// >>> " id { skip = 1 }
    !skip { print }
    skip && $0 ~ "^[[:space:]]*// <<< " id { skip = 0 }
  ' "$MENU" >"$tmp"
  jsonc_ok "$tmp" || { say "refusing: the menu file would not parse (left unchanged)" >&2; rm -f "$tmp"; exit 1; }
  write "$MENU" "$tmp"
  rm -f "$tmp"
  say "menu: removed $ID entries from $MENU"
}

install_waybar() {
  local d="$CFG/waybar"
  if [ "$DRY" = 1 ]; then say "would copy waybar-module.jsonc and waybar.css to $d/nucleon-sync.{jsonc,css}"; return; fi
  mkdir -p "$d"
  cp "$SNIPPETS/waybar-module.jsonc" "$d/nucleon-sync.jsonc"
  cp "$SNIPPETS/waybar.css" "$d/nucleon-sync.css"
  say "waybar: copied $d/nucleon-sync.jsonc and $d/nucleon-sync.css. Add to your Waybar config:"
  say '  "include": ["~/.config/waybar/nucleon-sync.jsonc"],   and "custom/nucleon-sync" to "modules-right"'
  say '  and to style.css:  @import "nucleon-sync.css";'
}

status() {
  local b=no m=no
  [ -f "$SHELL_JSON" ] && command -v jq >/dev/null 2>&1 && jq -e --arg id "$ID" '[.. | objects | select(.id? == $id)] | length > 0' "$SHELL_JSON" >/dev/null 2>&1 && b=yes
  [ -f "$MENU" ] && grep -q "^// >>> $ID" "$MENU" && m=yes
  say "bar entry:   $b ($SHELL_JSON)"
  say "menu block:  $m ($MENU)"
  say "bar output:  $("$(bar_helper)" omarchy)"
}

case "$cmd" in
  install)
    [ "$BAR" = 1 ] && install_bar
    [ "$MENU_ON" = 1 ] && install_menu
    [ "$WAYBAR" = 1 ] && install_waybar
    reload_shell
    ;;
  uninstall)
    uninstall_bar
    uninstall_menu
    reload_shell
    ;;
  status) status ;;
  *)
    sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'
    exit 2
    ;;
esac
