# Source package: builds the dashboard and the daemon bundle with pnpm + esbuild and runs both on the system Electron
# (electron44 from [extra]); no Electron binary is downloaded. The official Proton Drive CLI is a dependency
# (proton-drive-cli-bin or proton-drive-cli from the AUR) and is never bundled.
pkgname=nucleon-sync
pkgver=0.4.0
pkgrel=1
_electron=electron44
pkgdesc='Sync folders with Proton Drive (third-party app on the official proton-drive CLI): service, tray dashboard, agent CLI'
arch=('any')
url='https://github.com/flofischerpfuhl-stack/nucleon-sync'
license=('GPL-3.0-or-later')
depends=('proton-drive-cli' "${_electron}" 'libsecret' 'systemd' 'hicolor-icon-theme')
makedepends=('nodejs>=26' 'pnpm')
optdepends=(
  'gnome-keyring: Secret Service provider for the Proton session (Hyprland, GNOME)'
  'kwallet: Secret Service provider for the Proton session (KDE)'
  'libnotify: desktop notifications'
  'jq: nucleon-sync-omarchy (Omarchy bar and menu integration)'
)
provides=("${pkgname}")
conflicts=("${pkgname}-bin")
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
# filled in at release time (updpkgsums) once the v0.4.0 tag and release files exist
sha256sums=('SKIP')

build() {
  cd "${pkgname}-${pkgver}"
  export ELECTRON_SKIP_BINARY_DOWNLOAD=1
  pnpm install --frozen-lockfile
  node scripts/package.mjs --bundle-only
}

check() {
  cd "${pkgname}-${pkgver}"
  pnpm typecheck
}

package() {
  cd "${pkgname}-${pkgver}"
  install -d "${pkgdir}/usr/lib/${pkgname}"
  cp -a build/app "${pkgdir}/usr/lib/${pkgname}/app"
  cp -a build/daemon "${pkgdir}/usr/lib/${pkgname}/daemon"
  install -Dm755 packaging/arch/system-electron/nucleon-sync-gui "${pkgdir}/usr/bin/nucleon-sync-gui"
  install -Dm755 packaging/arch/system-electron/nucleon-sync-cli "${pkgdir}/usr/bin/nucleon-sync"
  install -Dm644 packaging/arch/system-electron/nucleon-sync.service "${pkgdir}/usr/lib/systemd/user/nucleon-sync.service"
  install -Dm644 packaging/arch/nucleon-sync.desktop "${pkgdir}/usr/share/applications/nucleon-sync.desktop"
  local d
  for d in packaging/icons/hicolor/*/apps; do
    install -Dm644 -t "${pkgdir}/usr/share/icons/hicolor/$(basename "$(dirname "$d")")/apps" "$d"/*
  done
  install -Dm755 packaging/omarchy/nucleon-sync-bar "${pkgdir}/usr/bin/nucleon-sync-bar"
  install -Dm755 packaging/omarchy/nucleon-sync-omarchy "${pkgdir}/usr/bin/nucleon-sync-omarchy"
  install -Dm644 -t "${pkgdir}/usr/share/${pkgname}/omarchy" packaging/omarchy/waybar-module.jsonc packaging/omarchy/waybar.css
  install -Dm644 agent-skill/SKILL.md "${pkgdir}/usr/share/${pkgname}/agent-skill/SKILL.md"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
