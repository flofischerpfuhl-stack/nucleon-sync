{
  "name": "nucleon-sync",
  "version": "0.3.1",
  "license": "GPL-3.0-or-later",
  "private": true,
  "description": "Proton Drive sync daemon + Electron dashboard for Linux (multi-account), built on the official proton-drive CLI",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@11.28.5",
  "scripts": {
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "pnpm -r run build",
    "dev:daemon": "node scripts/dev-env.mjs daemon",
    "dev:ui": "node scripts/dev-env.mjs ui",
    "dev": "node scripts/dev-env.mjs all",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.2",
    "electron-builder": "26.15.3",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "prettier": "3.9.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  }
}
