    "test:e2e": "node build.mjs && playwright test"
  },
  "dependencies": {
    "@nucleon-sync/shared": "workspace:*",
    "qrcode-generator": "2.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "44.4.5",
    "esbuild": "0.28.2"
  }
}
