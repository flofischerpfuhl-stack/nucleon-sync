{
  "name": "@nucleon-sync/ui",
  "version": "0.3.0",
  "license": "GPL-3.0-or-later",
  "private": true,
  "type": "module",
  "description": "Electron dashboard for nucleon-sync (tray, notifications, all accounts in one window)",
  "main": "out/main.cjs",
  "scripts": {
    "build": "node build.mjs",
